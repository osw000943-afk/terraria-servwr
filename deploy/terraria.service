[Unit]
Description=Terraria dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terraria
Group=terraria
WorkingDirectory=/opt/terraria
ExecStart=/opt/terraria/TerrariaServer.bin.x86_64 -config /etc/terraria/serverconfig.txt
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/terraria /var/lib/terraria
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
